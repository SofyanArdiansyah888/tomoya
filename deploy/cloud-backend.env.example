# Tambahan .env untuk instance CLOUD (tomoya4management.net).
# Bagian lain (.env APP_*, DB_*) tetap seperti konfigurasi hosting yang sekarang.

# Cloud = node "C", role "server" (menerima push & melayani pull dari PC kasir).
SYNC_ENABLED=true
SYNC_NODE_CODE=C
SYNC_ROLE=server
# Token acak panjang, HARUS sama persis dengan SYNC_TOKEN di PC kasir.
SYNC_TOKEN=
# Peringatan "PC kasir tidak terhubung" setelah N menit tanpa sinkron.
SYNC_OFFLINE_ALERT_MINUTES=5

# Izinkan PC kasir menjalankan migration di cloud (php artisan sync:remote ...). Set false setelah selesai.
SYNC_ALLOW_MAINTENANCE=false

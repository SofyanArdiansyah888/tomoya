# PC Kasir + Cloudflare Tunnel — salin ke backend/.env
APP_NAME=Tomoya
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tomoya4management.net

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tomoya
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Laragon: sesuaikan DB_USERNAME/DB_PASSWORD jika berbeda

# --- Sinkronisasi PC kasir <-> cloud (lihat dokumentasi/sinkronisasi-offline-online.md) ---
# PC kasir = node "L", role "client" (memulai push/pull setiap menit).
SYNC_ENABLED=true
SYNC_NODE_CODE=L
SYNC_ROLE=client
SYNC_REMOTE_URL=https://tomoya4management.net
# Token acak panjang, HARUS sama persis dengan SYNC_TOKEN di cloud.
SYNC_TOKEN=
# Backup harian mysqldump (Laragon: arahkan ke mysqldump.exe jika tidak ada di PATH)
SYNC_BACKUP_ENABLED=true
SYNC_MYSQLDUMP_PATH=mysqldump
SYNC_BACKUP_KEEP_DAYS=14
